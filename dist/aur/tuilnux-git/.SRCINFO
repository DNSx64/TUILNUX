pkgbase = tuilnux-git
	pkgdesc = Terminal desktop environment: fullscreen terminal with windows, taskbar, task manager and TUI apps (git version)
	pkgver = 0.2.0.r0.g7f6b607
	pkgrel = 1
	url = https://github.com/DNSx64/TUILNUX
	install = tuilnux.install
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = git
	depends = glibc
	depends = libgcc
	depends = bash
	optdepends = greetd: login via tlogin at boot
	optdepends = pam-u2f: security keys (FIDO2/U2F) at login
	optdepends = libpam-google-authenticator: phone codes via QR pairing at login
	optdepends = labwc: graphical backend with movable windows for GUI programs
	optdepends = xorg-xwayland: X11 programs in the labwc backend
	optdepends = foot: terminal for the graphical backends
	optdepends = wlr-randr: display settings (resolution, refresh rate, scaling, multi-monitor)
	optdepends = wl-clipboard: paste images from the clipboard into the terminal
	optdepends = nvidia-utils: NVIDIA graphics under Wayland
	optdepends = cage: alternative kiosk backend
	optdepends = gpm: mouse clicks on the plain Linux console
	optdepends = terminus-font: proper box drawing on the Linux console
	provides = tuilnux=0.2.0
	conflicts = tuilnux
	options = !debug
	backup = etc/tuilnux/session.conf
	source = tuilnux::git+https://github.com/DNSx64/TUILNUX.git
	sha256sums = SKIP

pkgname = tuilnux-git
